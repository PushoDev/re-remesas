DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,re-re-api.test
CSRF_TRUSTED_ORIGINS=https://re-re-api.test
CORS_ALLOWED_ORIGINS=https://re-re.test,http://localhost:5173

# Postgres: ajustar host/puerto/usuario/password/nombre de base a tu entorno
DATABASE_URL=postgres://postgres:postgres@localhost:5432/re_re

# Cookie del refresh token: True en HTTPS/producción, False en desarrollo local (http)
AUTH_COOKIE_SECURE=False

# Secreto para firmar/verificar los webhooks de la pasarela simulada. Cámbialo fuera de desarrollo.
PAYMENT_WEBHOOK_SECRET=change-me

# Checkout simulado de pagos (solo desarrollo). Debe ser False en producción.
PAYMENT_MOCK_ENABLED=True
